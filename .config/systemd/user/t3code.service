[Unit]
Description=T3 Code server
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
Environment=T3CODE_HOME=/home/ponraaj/.t3
Environment=T3_BOOT_SERVICE_UNIT=t3code.service
ExecStart=/home/ponraaj/.nvm/versions/node/v24.18.0/bin/node /home/ponraaj/.t3/runtime/versions/0.0.31/node_modules/t3/dist/bin.mjs serve
Restart=always
RestartSec=5
StandardOutput=append:/home/ponraaj/.t3/userdata/logs/boot-service.log
StandardError=append:/home/ponraaj/.t3/userdata/logs/boot-service.log

[Install]
WantedBy=default.target
